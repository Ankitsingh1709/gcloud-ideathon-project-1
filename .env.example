# =========================================================================
#                   AI JOURNAL REFLECT - ENV CONFIGURATION
# =========================================================================
# This file serves as a blueprint for configuring your application.
# Copy this file to '.env' and populate it with actual values.
# Do not commit the '.env' file containing secrets to version control.
# =========================================================================

# -------------------------------------------------------------------------
# 🔑 SERVER-ONLY SECRETS (Never exposed to the browser)
# -------------------------------------------------------------------------

# Gemini API Key: Required for server-side AI summary, category, and mood generation.
# In Google AI Studio, this is automatically injected securely from user secrets.
# For manual local development or deployment, obtain a key from https://aistudio.google.com/
GEMINI_API_KEY="AIzaSyYour_Gemini_API_Key_Here"

# -------------------------------------------------------------------------
# 🌐 OPERATIONAL CONFIGURATIONS (Server-side environments)
# -------------------------------------------------------------------------

# Node Environment: Options are 'development' or 'production'
NODE_ENV="development"

# Server Port: The port the Express backend server binds to (default: 3000)
PORT=3000

# App URL: Hostname where the applet runs (used for dynamic metadata resolution)
# Automatically resolved by the hosting platform during cloud deployments.
APP_URL="http://localhost:3000"

# -------------------------------------------------------------------------
# 🛠️ CLIENT-SIDE BUILD-TIME VARIABLES (VITE_ Prefixed)
# -------------------------------------------------------------------------
# Variables with the 'VITE_' prefix are parsed and hardcoded into the bundle 
# during the static compilation phase ('npm run build').

# Google Maps API Key: Required for address search and Map rendering in Journal Entries.
# Restrict this key to the Google Maps JS API and Geocoding API in GCP Console.
VITE_GOOGLE_MAPS_API_KEY="AIzaSyYour_Maps_API_Key_Here"

# -------------------------------------------------------------------------
# 🔄 DEVELOPMENT TOOLING SETTINGS
# -------------------------------------------------------------------------

# Disable Hot Module Replacement (HMR): Used to control dev server reloads
DISABLE_HMR="false"
